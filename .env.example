# ================================
# PMU Platform - Environment Variables
# ================================
# Copy this file to .env and fill in your values

# --- Backend ---
NODE_ENV=development
PORT=4000
# MySQL connection string used by Prisma
DATABASE_URL=mysql://user:password@localhost:3306/pmu_db
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Gambler API (service externe de generation des pronostics) ---
# URL du serveur gambler-api deploye (ex: https://theracingapi.iya-pmu.cloud)
GAMBLER_API_URL=
# Cle partagee avec le gambler-api (doit correspondre au API_KEY du serveur)
GAMBLER_API_KEY=

# --- SMS Provider ---
# Available: mock | orange | twilio | smpp
SMS_PROVIDER=mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER=IYA
# Required only when SMS_PROVIDER=twilio
SMS_TWILIO_ACCOUNT_SID=
# Required only when SMS_PROVIDER=smpp (ONatel / operateur SMPP)
SMPP_HOST=
SMPP_PORT=5019
SMPP_LOGIN=
SMPP_PASSWORD=

# --- Frontend ---
VITE_API_URL=http://localhost:4000/api

# URL publique du frontend (pour CORS en production, ex: https://mon-app.com)
FRONTEND_URL=
